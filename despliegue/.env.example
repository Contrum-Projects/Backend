# Servidor de la demo (SCRUM-166). Copia este archivo a .env en esta misma carpeta y complétalo.
# Nunca subas el .env al repositorio (RNF-10). Lo leen docker compose y la API.
# Reemplaza demo.ejemplo.cl por el subdominio real en todas las líneas.

# ── Base de datos ──
POSTGRES_USER=cp
# Obligatoria: genera una con  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=cabello_perfecto

# ── Dirección pública (la misma en las tres) ──
URL_TIENDA=https://demo.ejemplo.cl
URL_API=https://demo.ejemplo.cl
CORS_ORIGINS=https://demo.ejemplo.cl
# nginx → Next → API. Next no agrega X-Forwarded-For si ya viene, y nginx lo reemplaza por la IP
# real del cliente: con 1 la API toma esa IP y nadie puede falsearla (RNF-09). No uses 2 aquí.
PROXIES_CONFIABLES=1

# ── Autenticación ── (cada uno con  openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Cuenta del administrador que crea la semilla ──
# Obligatorias en producción. Úsalas para entrar a /ingresar y cámbiala después si quieres.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Correos: Resend ── (obligatoria en producción: sin ella la API no arranca)
# El dominio del remitente debe estar verificado en Resend (registros DNS que te da Resend).
RESEND_API_KEY=
# Remitente con nombre visible. Este comentario va entre las dos líneas a propósito: sin él,
# gitleaks leía este valor como si fuera la clave de arriba (falso positivo, SCRUM-161).
CORREO_REMITENTE=Cabello Perfecto <no-responder@demo.ejemplo.cl>
CORREO_CONTACTO=contacto@demo.ejemplo.cl
# Webhook de Resend (evento email.bounced) a https://demo.ejemplo.cl/api/marketing/rebotes.
# Vacío, el aviso de rebote responde 503 y nada más.
RESEND_WEBHOOK_SECRET=

# ── Imágenes del catálogo: Cloudflare R2 ── (las cinco o ninguna; sin ellas no se suben fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dominio público del bucket, sin "/" final. También lo usa la tienda al compilar.
R2_URL_PUBLICA=

# ── Mercado Pago: MODO DE PRUEBA ──
# Access token de las credenciales de prueba de la aplicación (o del vendedor de prueba).
# Se paga con las tarjetas de prueba de Mercado Pago, nunca con una real.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook configurado en la aplicación, con la URL
# https://demo.ejemplo.cl/api/pagos/notificaciones y el evento «Pagos».
MERCADOPAGO_WEBHOOK_SECRET=

# ── Chilexpress: MODO DE PRUEBA ──
# En producción la URL es obligatoria si hay clave: aquí va la del ambiente de prueba.
CHILEXPRESS_URL_BASE=https://testservices.wschilexpress.com
CHILEXPRESS_CLAVE_COTIZACION=
CHILEXPRESS_CLAVE_ENVIOS=
CHILEXPRESS_RUT_EMPRESA=
# Tarjeta Cliente de pruebas de Chilexpress. Vacía, la OT se crea en el portal y su número se
# escribe a mano al despachar.
CHILEXPRESS_TCC=18578680
CHILEXPRESS_REMITENTE_NOMBRE=Cabello Perfecto
CHILEXPRESS_REMITENTE_TELEFONO=
CHILEXPRESS_REMITENTE_CORREO=

# ── Verificación de profesionales: Khipu ──
# En producción no se acepta SII_PROVEEDOR=simulado. Sin credenciales, la consulta al SII falla
# y la solicitud pasa a revisión manual con documentos (se puede mostrar desde el panel).
SII_PROVEEDOR=khipu
# «Id de cobrador» y «Llave» de la cuenta de Khipu (van juntos)
KHIPU_CLIENT_ID=
KHIPU_CLIENT_SECRET=

# ── Descripciones con IA ── (opcionales: vacías, la descripción se escribe a mano)
GEMINI_API_KEY=
GROQ_API_KEY=
