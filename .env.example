# Copia este archivo a .env (nunca subas .env al repositorio: RNF-10).
# Con docker compose, los valores de abajo ya funcionan tal cual.

# ── App ──
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS, separados por coma (tienda y panel)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
# Proxies delante del backend, que reenvían la IP del cliente en X-Forwarded-For (RNF-09).
# En local es 1: el navegador habla con Next (:3001) y su proxy /api/[...ruta] llama a este
# backend. Con 0 todo el tráfico contaría como la IP de Next y los límites por IP se
# compartirían entre todos. En producción, los que haya (proxy de Next + Cloudflare/balanceador).
# Solo 0 si llamas al backend directo, sin pasar por Next.
PROXIES_CONFIABLES=1

# ── PostgreSQL ──
POSTGRES_USER=cp
POSTGRES_PASSWORD=cp
POSTGRES_DB=cabello_perfecto
# Desde tu equipo usa localhost; dentro de docker compose el host es "db"
DATABASE_URL=postgresql://cp:cp@localhost:5432/cabello_perfecto?schema=public

# ── Redis (colas BullMQ, límites, revocación y caché) ──
REDIS_URL=redis://localhost:6379

# ── Autenticación ──
# Genera cada secreto con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-acceso
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-de-refresco
JWT_REFRESH_TTL=30d

# ── Cuentas ──
# Base de los enlaces de los correos (la tienda); el enlace de confirmación dura estas horas
URL_TIENDA=http://localhost:3001
CONFIRMACION_CORREO_HORAS=24
# Horas que dura el enlace de invitación al personal para definir su contraseña
INVITACION_PERSONAL_HORAS=72
# Horas que dura el enlace para recuperar la contraseña
RECUPERACION_CONTRASENA_HORAS=1

# ── Reglas de negocio (Requerimientos, 8 oct) ──
IVA_PORCENTAJE=19
PLAZO_PAGO_MINUTOS=15
# Segundos que el árbol de categorías y las marcas de la tienda quedan en caché (Redis)
CACHE_CATALOGO_SEGUNDOS=300

# ── Imágenes del catálogo: Cloudflare R2 (API S3) ──
# Van las cinco o ninguna. Sin ellas la API arranca, pero subir imágenes responde 503.
# R2_URL_PUBLICA es el dominio público del bucket (r2.dev o propio), sin "/" final.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_URL_PUBLICA=

# ── Servicios externos (se completan cuando se contraten) ──
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Clave de la API Cotizador de Chilexpress Developers. Sin ella, cotizar el despacho responde 503.
CHILEXPRESS_CLAVE_COTIZACION=
# Clave de la API Envíos y RUT de la empresa dueña de las OT, sin puntos ni dígito verificador.
# Sin alguna de las dos, los envíos conservan su último estado.
CHILEXPRESS_CLAVE_ENVIOS=
CHILEXPRESS_RUT_EMPRESA=
# Vacía usa el sandbox. Obligatoria en producción si hay clave: https://services.wschilexpress.com
CHILEXPRESS_URL_BASE=
# Clave de la API de Resend. Vacía, fuera de producción, los correos se simulan: no sale nada.
# Obligatoria en producción. El dominio del remitente debe estar verificado en Resend.
RESEND_API_KEY=
# false apaga el envío de correos en esta instancia (los e2e lo hacen así).
CORREOS_WORKER_ACTIVO=true
CORREO_REMITENTE="Cabello Perfecto <no-responder@cabelloperfecto.cl>"
# Secreto (whsec_...) del webhook de Resend que avisa los rebotes a POST /api/marketing/rebotes
# (evento email.bounced). Vacío, el aviso responde 503 y no se registra nada.
RESEND_WEBHOOK_SECRET=
# Dirección pública de esta API, sin /api. La usan la imagen de apertura y los enlaces de clic
# de la publicidad. Vacía, los correos salen sin seguimiento.
URL_API=
# Clave de la API de Gemini (Google AI Studio). Vacía, sugerir la descripción desde la foto
# del reverso responde 503 y se escribe a mano. La clave real va solo en tu .env.
GEMINI_API_KEY=
# gemini-2.5-flash ya no se habilita para cuentas nuevas (404 «no longer available to new users»)
GEMINI_MODELO=gemini-3.8-flash
# Si el modelo principal falla (503, 504 o no responde a tiempo) se prueba este, más liviano.
# Vacío, sin respaldo de Gemini.
GEMINI_MODELO_RESPALDO=gemini-3.5-flash-lite
# Clave de la API de Groq (console.groq.com): último respaldo si Gemini no responde. Vacía, no se
# usa. El modelo debe tener visión (lee la foto del reverso). Solo en tu .env.
GROQ_API_KEY=
GROQ_MODELO=qwen/qwen3.8-27b
# Clave de la API de Khipu, que consulta el inicio de actividades en el SII al solicitar la
# verificación como profesional. Vacía, la consulta falla y se piden documentos. Solo en tu .env.
KHIPU_API_KEY=
# Vacía usa https://api.khipu.com
KHIPU_URL_BASE=
# khipu consulta de verdad. simulado es solo para desarrollo y responde según el último dígito del
# RUT: 0 sin inicio de actividades, 1 otro giro, 2 la consulta falla, cualquier otro peluquería.
SII_PROVEEDOR=khipu
