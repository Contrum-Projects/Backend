# Copia este archivo a .env (nunca subas .env al repositorio: RNF-10).
# Con docker compose, los valores de abajo ya funcionan tal cual.

# ── App ──
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS, separados por coma (tienda y panel)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ── PostgreSQL ──
POSTGRES_USER=cp
POSTGRES_PASSWORD=cp
POSTGRES_DB=cabello_perfecto
# Desde tu equipo usa localhost; dentro de docker compose el host es "db"
DATABASE_URL=postgresql://cp:cp@localhost:5432/cabello_perfecto?schema=public

# ── Redis (colas BullMQ, límites, revocación y caché) ──
REDIS_URL=redis://localhost:6379

# ── Autenticación ──
# Genera cada secreto con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-acceso
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo-de-refresco
JWT_REFRESH_TTL=30d

# ── Cuentas ──
# Base de los enlaces de los correos (la tienda); el enlace de confirmación dura estas horas
URL_TIENDA=http://localhost:3001
CONFIRMACION_CORREO_HORAS=24
# Horas que dura el enlace de invitación al personal para definir su contraseña
INVITACION_PERSONAL_HORAS=72

# ── Reglas de negocio (Requerimientos, 8 oct) ──
IVA_PORCENTAJE=19
MINIMO_UNIDADES_PELUQUERO=3
PLAZO_PAGO_MINUTOS=15

# ── Servicios externos (se completan cuando se contraten) ──
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
BLUEEXPRESS_API_KEY=
SMTP_URL=
CORREO_REMITENTE="Cabello Perfecto <no-responder@cabelloperfecto.cl>"
